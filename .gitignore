# AI Workflow Kit - State and Output Directories
.ai/state/
.ai/results/
.ai/runs/
.ai/exe-logs/
.ai/logs/

# Same runtime dirs when created under a package dir by tests running there
# (the patterns above are root-anchored due to their internal slash)
**/.ai/state/
**/.ai/results/
**/.ai/runs/
**/.ai/exe-logs/
**/.ai/logs/

# Worktrees
.worktrees/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code local settings (do not commit)
.claude/settings.local.json
# Symlinks generated locally by `awkit install` (ensureClaudeLinks); ignoring
# them also stops Windows git from warning while trying to traverse them
.claude/rules
.claude/skills
.claude/worktrees/

# Kiro IDE local workspace
.kiro/

awkit.exe
