# AI Workflow Kit: what a run leaves behind (results, logs, state)
.ai/state/

# The same, where a test that runs in a package directory creates it
# (the pattern above is anchored at the root by its inner slash)
**/.ai/state/

# Worktrees
.worktrees/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code local settings (do not commit)
.claude/settings.local.json
.claude/worktrees/

# Kiro IDE local workspace
.kiro/

awkit.exe

# The workbench page is built from web/ (npm --prefix web run build); only the placeholder is kept.
internal/workbench/dist/*
!internal/workbench/dist/.keep
web/node_modules/
